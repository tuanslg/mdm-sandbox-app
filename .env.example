# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Used via: flutter run --dart-define-from-file=.env

# Sentry DSN — Sentry > Settings > Projects > <project> > Client Keys (DSN)
SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/PROJECT_ID

# Environment tag: development | staging | production
SENTRY_ENV=development
